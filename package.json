{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write \"resources/views/**/*.blade.php\" \"app/**/*.php\" \"routes/**/*.php\" \"database/**/*.php\"",
    "format:check": "prettier --check \"resources/views/**/*.blade.php\" \"app/**/*.php\" \"routes/**/*.php\" \"database/**/*.php\""
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.26.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-blade": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  }
}
